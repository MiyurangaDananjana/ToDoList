@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="aspnetTitle">
        <h1 id="title">🧑‍🚀 My To-Do List</h1>
        <p class="lead">
            This To-Do List Application is a simple yet powerful tool designed to help you manage your daily tasks efficiently. It allows you to add new tasks, mark them as complete, and delete them with ease.

            The app leverages Firestore for real-time data persistence, meaning your to-dos are saved securely and update instantly across your devices. This ensures you always have an up-to-date list, helping you stay organized and productive.
        </p>
        <p><a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-md">🔐 Login &raquo;</a></p>
    </section>

    <div class="row">
       
    </div>
</main>