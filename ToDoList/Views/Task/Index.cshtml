
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-4" data-bind="with: taskVM">
    <h2 class="text-center mb-4">📝 Task Manager</h2>

    <!-- Add Task Form -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h6 class="card-title">Add New Task</h6>
            <div class="row g-3">
                <div class="col-md-5">
                    <textarea type="text" class="form-control" placeholder="Enter task title..." data-bind="value: newTaskTitle"> </textarea>
                </div>
                <div class="col-md-4">
                    <select class="form-select" data-bind="options: categories, optionsText: 'Name', optionsValue: 'Id', value: selectedCategory, optionsCaption: 'Select Category'"></select>
                </div>
                <div class="col-md-3 d-grid">
                    <button class="btn btn-primary" data-bind="click: addTask, enable: newTaskTitle() && selectedCategory()"> ⏱️ Add Task</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Task List -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Task List</h5>

            <!-- No tasks -->
            <div data-bind="if: tasks().length === 0">
                <p class="text-muted">No tasks added yet.</p>
            </div>

            <!-- Tasks Table -->
            <table class="table table-bordered" data-bind="if: tasks().length > 0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th>Task</th>
                        <th>Category</th>
                        <th style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: tasks">
                    <tr>
                        <td class="text-center" data-bind="text: $index() + 1"></td>
                        <td data-bind="text: title"></td>
                        <td data-bind="text: categoryName"></td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.removeTask">Delete</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
@section scripts {
    <script src="~/Scripts/knockout-3.5.1.js"></script>
    <script>
        // Task model
        function Task(id, title, categoryId, categoryName) {
            this.taskId = ko.observable(id);
            this.title = ko.observable(title);
            this.categoryId = ko.observable(categoryId);
            this.categoryName = ko.observable(categoryName);
        }

        // ViewModel
        function TaskViewModel() {
            var self = this;
            self.newTaskTitle = ko.observable('');
            self.selectedCategory = ko.observable();
            self.categories = ko.observableArray([]);
            self.tasks = ko.observableArray([]);

            // Load categories
            self.loadCategories = function () {
                $.getJSON('/Task/GetCategories', function (data) {
                    self.categories(data);
                });
            };

            // Load tasks from server
            self.loadTasks = function () {
                $.getJSON('/Task/GetTasks', function (data) {
                    const mapped = data.map(t =>
                        new Task(t.TaskId, t.Title, t.CategoryId, t.CategoryName)
                    );
                    self.tasks(mapped);
                });
            };

            // Add new task
            self.addTask = function () {
                if (!self.newTaskTitle().trim() || !self.selectedCategory()) {
                    alert('Please enter a title and select a category.');
                    return;
                }

                var selected = self.categories().find(cat => cat.Id === self.selectedCategory());

                var taskData = {
                    Title: self.newTaskTitle(),
                    CategoryId: selected.Id
                };

                $.ajax({
                    url: '/Task/SaveTask',
                    type: 'POST',
                    data: JSON.stringify(taskData),
                    contentType: 'application/json; charset=utf-8',
                    success: function (response) {
                        if (response.success) {
                            self.tasks.push(new Task(response.taskId, taskData.Title, selected.Id, selected.Name));
                            self.newTaskTitle('');
                            self.selectedCategory(null);
                        } else {
                            alert('Error saving task: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Server error while saving task.');
                    }
                });
            };

            // Delete task
            self.removeTask = function (task) {
                if (confirm("Are you sure you want to delete this task?")) {
                    $.ajax({
                        url: '/Task/DeleteTask?taskId=' + task.taskId(),
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                self.tasks.remove(task);
                            } else {
                                alert("Error deleting task: " + response.message);
                            }
                        },
                        error: function () {
                            alert("Server error while deleting task.");
                        }
                    });
                }
            };

            // Init
            self.loadCategories();
            self.loadTasks();
        }

        const taskVM = new TaskViewModel();
        ko.applyBindings({ taskVM: taskVM });
    </script>
}
